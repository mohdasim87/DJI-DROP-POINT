[Unit]
Description=DropPoint payload-drop guidance system
After=network.target
StartLimitIntervalSec=0

[Service]
# Type=notify: the app calls sd_notify READY=1 once the guidance loop is up
# and WATCHDOG=1 every tick (src/hw/sd_notify.*); systemd kills it if the
# loop wedges for more than WatchdogSec.
Type=notify
NotifyAccess=main
ExecStart=/opt/droppoint/bin/droppoint --config /opt/droppoint/config --credentials /etc/droppoint/credentials.yaml
Restart=on-failure
RestartSec=2
WatchdogSec=5
User=droppoint
Group=droppoint
# dialout for the /dev/tty* UART adapter; systemd creates /var/log/droppoint
# (LogsDirectory) and /run/droppoint (RuntimeDirectory) owned by the service
# user — the app puts its per-process widget files under RuntimeDirectory
# and keeps files in the log dir owned by the service user. When checking an
# install by hand, run the self-test the same way the service runs:
#   sudo -u droppoint /opt/droppoint/bin/droppoint --selftest --no-link \
#     --config /opt/droppoint/config
SupplementaryGroups=dialout
LogsDirectory=droppoint
RuntimeDirectory=droppoint
StandardOutput=append:/var/log/droppoint/service.log
StandardError=append:/var/log/droppoint/service.log

[Install]
WantedBy=multi-user.target
